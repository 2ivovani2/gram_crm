# ─────────────────────────────────────────────────────────────────────────────
# Gramly — root .env
# cp .env.example .env  then fill in the values.
#
# This file drives ALL ${...} variable interpolation in docker-compose.yml,
# docker-compose.dev.yml, and docker-compose.ngrok.yml.
#
# spambotcontrol service-level vars (Django settings, bot tokens, etc.) live in
# spambotcontrol/.env (see spambotcontrol/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared PostgreSQL ─────────────────────────────────────────────────────────
# DATABASE_URL in spambotcontrol/.env must match these credentials and database.
POSTGRES_DB=gramly
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# ── MinIO (shared S3-compatible file storage) ─────────────────────────────────
# Dev:  set bucket public-read; files served at http://localhost:9000
# Prod: files served via nginx /s3/ proxy at https://gramly.tech/s3
# Change credentials from minioadmin in production.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=spambotcontrol


# ── Production domain ─────────────────────────────────────────────────────────
# Used by scripts/prod_up.sh for Let's Encrypt cert issuance and webhook URL.
DOMAIN=gramly.tech
CERTBOT_EMAIL=admin@gramly.tech

# ── Dev only: ngrok tunnel ────────────────────────────────────────────────────
# Required for make dev. Get a free static domain at dashboard.ngrok.com.
# NGROK_DOMAIN is also forwarded into the Django container so settings/dev.py
# can build absolute URLs (Telegram Login Widget requires HTTPS).
NGROK_AUTHTOKEN=your-ngrok-authtoken-here
NGROK_DOMAIN=your-static-domain.ngrok-free.app
