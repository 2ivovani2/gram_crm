# ─── Copy this file to .env and fill in values ───────────────────────────────
# cp .env.example .env
#
# In unified prod (root docker-compose.yml), these vars are passed via
# environment: block — you don't need a separate .env for prod.

# ── Ports (standalone dev only — not used in unified compose) ─────────────────
NGINX_PORT=80

# ── Next.js public API URL ────────────────────────────────────────────────────
# Dev (standalone):  frontend calls backend directly on the host
NEXT_PUBLIC_API_URL=http://localhost:8000

# Prod (unified compose):
# NEXT_PUBLIC_API_URL=https://spam.gramly.tech/api

# ── Database ──────────────────────────────────────────────────────────────────
# Dev (standalone SQLite — default if not set):
# DATABASE_URL=sqlite:///./data/database.db

# Prod (shared PostgreSQL in unified compose):
# DATABASE_URL=postgresql://postgres:<password>@postgres:5432/autosending

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_32_chars_minimum_please
